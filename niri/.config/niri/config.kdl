// ── Input ──────────────────────────────────────────────────────────────────
input {
    keyboard {
        xkb {
            layout "us"
            // options "caps:escape"   // uncomment to remap Caps to Escape
        }
        repeat-delay 300
        repeat-rate 50
    }

    touchpad {
        tap
        natural-scroll
        accel-speed 0.2
    }

    mouse {
        accel-speed 0.0
    }

    disable-power-key-handling
}

// ── Outputs ────────────────────────────────────────────────────────────────
/*output "eDP-1" {
    scale 1.0
    mode "1920x1080@60.0"
}

output "HDMI-A-1" {
    scale 1.0
}*/
output "HDMI-A-1" {
    mode "1920x1080@60.000"
    position x=1366 y=0
    scale 1.5
}

output "PNP(CTV) CultraviewTV 0x01010101" {
    // alternate way to match — niri accepts either the connector name
    // (HDMI-A-1) or the make/model string, connector name is simpler
}

output "eDP-1" {
    mode "1366x768@60.000"
    position x=0 y=0
    scale 1.0
}
/*output "eDP-1" {
		off
}*/

// ── Layout ─────────────────────────────────────────────────────────────────
prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

environment {
    Display ":1"
    _JAVA_AWT_WM_NONREPARENTING ":1"
    AWT_TOOLKIT "MToolkit"
}

layout {
    gaps 6
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    default-column-width { proportion 0.5; }

focus-ring {
    width 2
    active-gradient from="#89b4fa" to="#cba6f7" angle=45 relative-to="workspace-view"
    inactive-color "#313244"
}

    border {
        off
    }
}

// ── Animations ─────────────────────────────────────────────────────────────
animations {
    // off

    window-close {
        duration-ms 120
        curve "ease-out-quad"
    }

    screenshot-ui-open {
        duration-ms 250
        curve "ease-out-quad"
    }

    workspace-switch {
        spring damping-ratio=0.8 stiffness=320 epsilon=0.001
    }

    config-notification-open-close {
        spring damping-ratio=0.8 stiffness=320 epsilon=0.001
    }

    overview-open-close {
        spring damping-ratio=0.72 stiffness=400 epsilon=0.0005
    }

    horizontal-view-movement {
        spring damping-ratio=0.8 stiffness=320 epsilon=0.001
    }

    window-resize {
        spring damping-ratio=0.8 stiffness=320 epsilon=0.001
    }

    window-open {
        spring damping-ratio=0.8 stiffness=320 epsilon=0.001
    }

    window-movement {
        spring damping-ratio=0.8 stiffness=320 epsilon=0.001
    }

    // slowdown 3.0
}

// ── Layer Rules ────────────────────────────────────────────────────────────
layer-rule {
    match namespace="waybar"
    opacity 0.8
    background-effect {
        xray true
        blur true
    }
}

layer-rule {
    match namespace="swaync-notification-window"
    block-out-from "screen-capture"
}

layer-rule {
    match namespace="swaync-control-center"
    match namespace="syshud"
    background-effect {
        xray false
        blur true
    }
}

layer-rule {
    match namespace="syshud"
    background-effect {
        xray false
        blur true
    }
    geometry-corner-radius 24
}

layer-rule {
    match namespace="launcher"
    background-effect {
        xray false
        blur true
    }
    geometry-corner-radius 6
}

layer-rule {
    match namespace=r#"^logout_dialog$"#
    background-effect {
        xray false
        blur true
    }
}

layer-rule {
    match namespace="^awww-daemonoverview-wall$"
    place-within-backdrop true
}

// ── Overview ───────────────────────────────────────────────────────────────
overview {
    // Dark frosted backdrop — matches your waybar bg
    backdrop-color "#11111bcc"

    workspace-shadow {
        on
        softness 40
        spread 5
        offset x=0 y=8
        color "#00000066"
    }
}
// ── Workspaces ─────────────────────────────────────────────────────────────
workspace " "
workspace " "
workspace " "

// ── Window Rules ───────────────────────────────────────────────────────────
// Global defaults
window-rule {
    draw-border-with-background false
    geometry-corner-radius 9
    clip-to-geometry true
}

// Standardized sizing and floating rules for TUI overlays
window-rule {
    match app-id=r#"^tui-overlay$"#
    open-floating true
    default-column-width { fixed 850; }
    default-window-height { fixed 550; }
    opacity 0.95
    background-effect {
        blur true
    }
}

window-rule {
    match app-id="wallpaper-picker"

    open-floating true

    // Dimensions for the floating window
    default-column-width { fixed 1000; }
    default-window-height { fixed 650; }

    // Centered positioning with optional offsets (default centers automatically)
    // default-floating-position x=0 y=0
}

// Blur effects for common apps
window-rule {
    match app-id=r#"^org.gnome.Nautilus$"#
    match app-id=r#"^org.gnome.Papers$"#
    match app-id=r#"^org.gnome.Loupe$"#
    match app-id=r#"^io.github.celluloid_player.Celluloid$"#
    match app-id=r#"^zenity$"#
    background-effect {
        xray false
        blur true
    }
}

// Floating dialogs & tools
window-rule {
    match app-id=r#"^org\.kde\.kdeconnect\.daemon$"#
    match app-id=r#"^galculator$"#
    match app-id=r#"^org.kde.kdeconnect.handler$"#
    match app-id=r#"^thunar$"# title="^Rename*"
    match app-id=r#"^Vivado$"# title="^win0$"
    match app-id=r#"^java$"#
    match app-id=r#"^Eclipse$"# title="^Eclipse IDE Launcher $"
    match app-id=r#"^STM32CubeIDE$"# title="^STM32CubeIDE Launcher $"
    match app-id=r#"^com-st-microxplorer-maingui-STM32CubeMX$"# title="^win0$"
    match app-id=r#"^Java$"#
    match app-id=r#"^zenity$"#
    match app-id=r#"^org.kde.kcalc$"#
    match app-id=r#"^Vivado 2022.2 Installer$"#
    match app-id=r#"^org.gnome.Calendar$"#
    match app-id=r#"^Tk$"#
    match app-id=r#"^org.gnome.Loupe$"#
    open-floating true
}

window-rule {
    match app-id=r#"^thunar$"# title="^File Operation Progress$"
    baba-is-float true
    open-floating true
}

// File managers — constrained floating size
window-rule {
    match app-id=r#"^thunar$"#
    match app-id=r#"^org.gnome.Nautilus$"#
    match app-id=r#"^pcmanfm$"#
    min-width 800
    max-width 1176
    min-height 600
    max-height 600
    open-floating true
}

// File upload dialogs
window-rule {
    match app-id=r#"^.*$"# title="^File Upload*"
    match app-id=r#"^.*$"# title="^Select Folder to Upload*"
    min-width 800
    max-width 1176
    min-height 900
    max-height 900
    open-floating true
}

// Privacy / screen capture exclusions
window-rule {
    match app-id="polkit-gnome-authentication-agent-1"
    match app-id="Bitwarden"
    block-out-from "screen-capture"
}

// Picture-in-picture
window-rule {
    match app-id=r#"zen$"# title="^Picture-in-Picture$"
    match app-id=r#"librewolf$"# title="^Picture-in-Picture$"
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// PCManFM — translucent with blur
window-rule {
    match app-id=r#"^pcmanfm$"#
    match app-id=r#"^thunar$"#
    //open-on-workspace " "
    opacity 0.72
    background-effect {
        xray true
        blur true
    }
}

// Workspace 1 — Terminal
window-rule {
    match app-id=r#"^kitty$"#
    open-on-workspace " "
    opacity 0.88
    background-effect {
        xray true
        blur true
    }
    default-column-width { proportion 0.5; }
}

// Workspace 2 — Browsers
window-rule {
    match app-id=r#"zen$"#
    match app-id=r#"vivaldi-stable$"#
    match app-id=r#"chromium$"#
    match app-id=r#"qutebrowser$"#
    match app-id=r#"librewolf$"#
    match app-id=r#"google-chrome$"#
    match app-id=r#"firefox$"#
    opacity 0.92
    background-effect {
        blur true
    }
    open-on-workspace " "
    open-focused true
    default-column-width { proportion 0.9; }
    // open-maximized-to-edges true
}

// Workspace 3 — Editors & IDEs
window-rule {
    match app-id=r#"^neovide$"#
    match app-id=r#"^dev.zed.Zed$"#
    match app-id=r#"^jetbrains-idea$"#
    match app-id=r#"^codium$"#
    match app-id=r#"^Vivado$"# title="^Vivado 2022.2$"
    match app-id=r#"^Vitis IDE$"#
    match app-id=r#"^uv4.exe"#
    match app-id=r#"^Eclipse$"#
    match app-id=r#"^STM32CubeIDE$"# title="^*STM32CubeIDE $"
    match app-id=r#"^labwc$"#
    match app-id=r#"^kitty$"# title=r#"^\[nvim\]$"#
    match app-id=r#"^gvim$"#
    //open-on-workspace "3"
    open-focused true
    open-maximized true
}

window-rule {
    match app-id=r#"^codium$"#
    match app-id=r#"^dev.zed.Zed$"#
    background-effect {
        blur true
    }
    opacity 0.9
}

// Workspace 4 — Documents, media, misc
window-rule {
    match app-id=r#"org.pwmt.zathura"#
    match app-id=r#"com.github.johnfactotum.Foliate"#
    match app-id=r#"^org.gnome.Papers$"#
    //open-on-workspace "4"
    open-focused true
    default-column-width { proportion 0.75; }
}

window-rule {
    match app-id=r#"^com.obsproject.Studio$"#
    match app-id=r#"^vesktop$"#
    match app-id=r#"^org.gnome.Snapshot$"#
    //open-on-workspace "4"
    open-focused true
}

window-rule {
    match app-id=r#"^virt-manager$"# title=r#"^.*QEMU/KVM$"#
    match app-id=r#"^libreoffice.*$"#
    match app-id=r#"^soffice$"#
    //open-on-workspace "4"
    open-focused true
    open-maximized true
}

// Prevent OBS control window from getting auto-tiled too narrow
window-rule {
    match app-id=r#"^com\.obsproject\.Studio$"#

    // Give OBS a comfortable starting width on the ribbon
    default-column-width { proportion 0.5; }
}

// OPTIONAL: Prevent specific sensitive apps from showing up in OBS screen capture
window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^Bitwarden$"#

    // OBS will record a black box for this window
    block-out-from "screen-capture"
}

// QtScrcpy
window-rule {
    match app-id=r#"QtScrcpy$"# title="^Phone-+"
    default-column-width { proportion 0.25; }
}

window-rule {
    match app-id=r#"QtScrcpy$"# title="^Tool$"
    open-floating false
    default-column-width {}
}

// Hotkey overlay
hotkey-overlay {
    skip-at-startup
}

// Firefox column width override
window-rule {
    match app-id="firefox"
    default-column-width { proportion 0.66667; }
}

// Shadows on floating windows
window-rule {
    match is-floating=true
    shadow { on; }
}

// Kitty — borderless, maximized
window-rule {
    match app-id=r#"^kitty$"#
    draw-border-with-background false
    open-maximized true
}

// ── Keybindings ────────────────────────────────────────────────────────────
binds {
    // ── launchers ──
    mod+shift+slash                                                                 { show-hotkey-overlay; }
    mod+d                                                                           { spawn "bash" "-c" "pkill fuzzel || fuzzel"; }
    Mod+Return                                                                      { spawn "default-terminal"; }
    Mod+Alt+Return                                                                  { spawn "default-terminal" "-e" "tmux" "new-session" "-A" "-s" "main"; }
    mod+b                                                                           { spawn "default-browser"; }
	Mod+Shift+alt+b hotkey-overlay-title="Open Private Browser"                     { spawn "default-browser-private"; }
    mod+e                                                                           { spawn "default-fm"; }
    mod+c                                                                           { spawn "default-editor"; }
    mod+s                                                                           { spawn "kitty" "nvim" "/home/lanre/.config/niri/config.kdl"; }
    mod+v                                                                           { spawn "~/.local/bin/cliphist-picker"; }
    mod+alt+l                                                                       { spawn "swaylock"; }
    mod+comma     hotkey-overlay-title="show emojis: fuzzel"     repeat=false       { spawn "bash" "-c" "pkill fuzzel || fuzzel-emoji"; }
    mod+shift+b   hotkey-overlay-title="toggle bar: waybar"      repeat=false       { spawn "toggle-waybar"; }
    //mod+w         repeat=false                                                      { spawn "kitty" "--app-id" "wallpaper-picker" "-e" "/home/lanre/dotfiles/scripts/wallpaper-picker.sh"; }
    mod+w         repeat=false                                                      { spawn "kitty" "--class" "tui-overlay" "-e" "/home/lanre/dotfiles/scripts/wallpaper-picker.sh"; }
    mod+alt+w     hotkey-overlay-title="random wallpaper & animation"               { spawn "random-wallpaper"; }
    mod+o         hotkey-overlay-title="toggle overview mode"     repeat=false       { toggle-overview; }

	// Omarchy-style System TUI overlays
    Mod+Ctrl+a   { spawn "kitty" "--class" "tui-overlay" "-e" "wiremix"; }            // Audio Mixer
    Mod+Ctrl+b   { spawn "kitty" "--class" "tui-overlay" "-e" "bluetui"; }            // Bluetooth Manager
    Mod+Ctrl+w   { spawn "kitty" "--class" "tui-overlay" "-e" "nmtui"; }             // Wi-Fi Manager (impala or nmtui)
    Mod+Ctrl+t   { spawn "kitty" "--class" "tui-overlay" "-e" "btop"; }               // System Monitor
    Mod+Ctrl+d   { spawn "kitty" "--class" "tui-overlay" "-e" "lazydocker"; }         // Docker TUI

    // ── session ──
    mod+q                                                                           { close-window; }
    //mod+shift+q                                                                     { quit; }
    mod+shift+q                                                                     { spawn "way-powermenu"; }
    Mod+Ctrl+Shift+Delete hotkey-overlay-title="Kill all windows (Global)"          { spawn "sh" "-c" "niri msg --json windows | jq -r '.[].id' | xargs -r -I {} niri msg action close-window --id {}"; }

    Mod+Alt+Delete hotkey-overlay-title="Kill all except focused (Global)"          { spawn "sh" "-c" "niri msg --json windows | jq -r '.[] | select(.is_focused == false) | .id' | xargs -r -I {} niri msg action close-window --id {}"; }

    Mod+Ctrl+Delete hotkey-overlay-title="Kill all except focused (Workspace)"      { spawn "sh" "-c" "niri msg --json windows | jq -r '(.[] | select(.is_focused == true) | .workspace_id) as $ws | .[] | select(.workspace_id == $ws and .is_focused == false) | .id' | xargs -r -I {} niri msg action close-window --id {}"; }

    Mod+Shift+Delete hotkey-overlay-title="Kill all on current workspace"           { spawn "sh" "-c" "niri msg --json windows | jq -r '(.[] | select(.is_focused == true) | .workspace_id) as $ws | .[] | select(.workspace_id == $ws) | .id' | xargs -r -I {} niri msg action close-window --id {}"; }

    // ── focus movement (vim-style) ──
    mod+h                                                                           { focus-column-left; }
    mod+l                                                                           { focus-column-right; }
    mod+j                                                                           { focus-window-down; }
    mod+k                                                                           { focus-window-up; }
    mod+left                                                                        { focus-column-left; }
    mod+right                                                                       { focus-column-right; }
    mod+up                                                                          { focus-window-up; }
    mod+down                                                                        { focus-window-down; }

    // ── move windows ──
    mod+shift+h                                                                     { move-column-left; }
    mod+shift+l                                                                     { move-column-right; }
	mod+shift+k                                                                     { move-window-up-or-to-workspace-up; }
    mod+shift+j                                                                     { move-window-down-or-to-workspace-down; }
    mod+shift+left                                                                  { move-column-left; }
    mod+shift+right                                                                 { move-column-right; }
	mod+shift+up                                                                    { move-window-up-or-to-workspace-up; }
    mod+shift+down                                                                  { move-window-down-or-to-workspace-down; }

    mod+home                                                                        { focus-column-first; }
    mod+end                                                                         { focus-column-last; }
    mod+ctrl+home                                                                   { move-column-to-first; }
    mod+ctrl+end                                                                    { move-column-to-last; }


    // ── column / window sizing ──
    mod+minus                                                                       { set-column-width "-10%"; }
    mod+equal                                                                       { set-column-width "+10%"; }
    mod+shift+minus                                                                 { set-window-height "-10%"; }
    mod+shift+equal                                                                 { set-window-height "+10%"; }
    mod+0                                                                           { set-column-width "100%"; }

    // ── monitor focus ──
    mod+ctrl+left                                                                   { focus-monitor-left; }
    mod+ctrl+down                                                                   { focus-monitor-down; }
    mod+ctrl+up                                                                     { focus-monitor-up; }
    mod+ctrl+right                                                                  { focus-monitor-right; }
    mod+ctrl+h                                                                      { focus-monitor-left; }
    mod+ctrl+j                                                                      { focus-monitor-down; }
    mod+ctrl+k                                                                      { focus-monitor-up; }
    mod+ctrl+l                                                                      { focus-monitor-right; }

    // ── move column to monitor ──
    mod+shift+ctrl+left                                                             { move-column-to-monitor-left; }
    mod+shift+ctrl+down                                                             { move-column-to-monitor-down; }
    mod+shift+ctrl+up                                                               { move-column-to-monitor-up; }
    mod+shift+ctrl+right                                                            { move-column-to-monitor-right; }
    mod+shift+ctrl+h                                                                { move-column-to-monitor-left; }
    mod+shift+ctrl+j                                                                { move-column-to-monitor-down; }
    mod+shift+ctrl+k                                                                { move-column-to-monitor-up; }
    mod+shift+ctrl+l                                                                { move-column-to-monitor-right; }

    // ── preset widths ──
    mod+r                                                                           { switch-preset-column-width; }

    // ── floating ──
    mod+shift+space                                                                           { toggle-window-floating; }
    mod+space                                                                       { switch-focus-between-floating-and-tiling; }

    // ── fullscreen ──
    mod+f                                                                     { maximize-window-to-edges; }
	mod+shift+f                                                                     { fullscreen-window; }
    mod+alt+f                                                                      { maximize-column; }

    // ── workspaces ──
    mod+1                                                                           { focus-workspace 1; }
    mod+2                                                                           { focus-workspace 2; }
    mod+3                                                                           { focus-workspace 3; }
    mod+4                                                                           { focus-workspace 4; }
    mod+5                                                                           { focus-workspace 5; }
    mod+6                                                                           { focus-workspace 6; }
    mod+7                                                                           { focus-workspace 7; }
    mod+8                                                                           { focus-workspace 8; }
    mod+9                                                                           { focus-workspace 9; }

    mod+shift+1                                                                     { move-column-to-workspace 1; }
    mod+shift+2                                                                     { move-column-to-workspace 2; }
    mod+shift+3                                                                     { move-column-to-workspace 3; }
    mod+shift+4                                                                     { move-column-to-workspace 4; }
    mod+shift+5                                                                     { move-column-to-workspace 5; }
    mod+shift+6                                                                     { move-column-to-workspace 6; }
    mod+shift+7                                                                     { move-column-to-workspace 7; }
    mod+shift+8                                                                     { move-column-to-workspace 8; }
    mod+shift+9                                                                     { move-column-to-workspace 9; }

    mod+g                                                                      { consume-window-into-column; }
    mod+alt+g                                                                { expel-window-from-column; }


    // there are also commands that consume or expel a single window to the side.
    mod+bracketleft                                                                 { consume-or-expel-window-left; }
    mod+bracketright                                                                { consume-or-expel-window-right; }

    mod+tab                                                                         { focus-workspace-down; }
    mod+shift+tab                                                                   { focus-workspace-up; }

    // ── media & brightness ──
    xf86audioraisevolume                                                            { spawn "wpctl" "set-volume" "@default_audio_sink@" "5%+"; }
    xf86audiolowervolume                                                            { spawn "wpctl" "set-volume" "@default_audio_sink@" "5%-"; }
    xf86audiomute                                                                   { spawn "wpctl" "set-mute" "@default_audio_sink@" "toggle"; }
    xf86monbrightnessup                                                             { spawn "brightnessctl" "set" "+5%"; }
    xf86monbrightnessdown                                                           { spawn "brightnessctl" "set" "5%-"; }
    xf86audioplay                                                                   { spawn "playerctl" "play-pause"; }
    xf86audionext                                                                   { spawn "playerctl" "next"; }
    xf86audioprev                                                                   { spawn "playerctl" "previous"; }

    // ── screenshots ──
    print                                                                           { screenshot; }
    ctrl+print                                                                      { screenshot-screen; }
    alt+print                                                                       { screenshot-window; }

    // -- Color Picker --
	mod+Print     hotkey-overlay-title="Color Picker"                               { spawn "bash" "-c" "hyprpicker -a || colorpicker"; }

	// -- mirroring
    mod+p repeat=false {
        spawn-sh "wl-mirror $(niri msg --json focused-output | jq -r .name)"
    }
}

// ── Autostart ──────────────────────────────────────────────────────────────
spawn-at-startup "waybar"
spawn-at-startup "mako"
spawn-at-startup "udiskie" "--smart-tray"
spawn-at-startup "niri-screen-time" "-daemon"
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
spawn-at-startup "awww-daemon"
spawn-at-startup "awww-daemon" "-n" "overview-wall"
spawn-at-startup "wl-paste" "--type" "text"  "--watch" "cliphist" "store"
spawn-at-startup "wl-paste" "--type" "image" "--watch" "cliphist" "store"
spawn-at-startup "wname" "LG4D"
spawn-at-startup "dbus-update-activation-environment" "--systemd" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP" "NIRI_SOCKET"
spawn-at-startup "dbus-update-activation-environment" "--systemd" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP"
spawn-at-startup "/usr/lib/xdg-desktop-portal-gnome" // Or xdg-desktop-portal-gtk
spawn-at-startup "/usr/lib/xdg-desktop-portal"
xwayland-satellite {
		off
}
